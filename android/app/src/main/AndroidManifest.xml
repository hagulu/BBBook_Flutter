<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- release 빌드도 백엔드 API를 호출하므로 필요 (debug manifest의 INTERNET 권한은
         Flutter 개발 도구 통신용이라 release에는 적용되지 않음) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 책 검색 화면의 바코드 스캔(mobile_scanner)에 필요 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <application
        android:label="북꾸러미"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- 기본 taskAffinity를 유지한다. 빈 값이면 네이버 Custom Tab 인증 반환 시
             별도 task에 Activity가 생성되어 기존 로그인 요청이 취소될 수 있다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="application/csv"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/x-zip-compressed"/>
                <data android:mimeType="application/x-bookmory"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="application/csv"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/x-zip-compressed"/>
                <data android:mimeType="application/x-bookmory"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 카카오 로그인 Redirect URI(kakao${kakaoNativeAppKey}://oauth) 처리용.
             네이티브 앱 키는 build.gradle.kts가 local.properties에서 주입한다. -->
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:host="oauth" android:scheme="kakao${kakaoNativeAppKey}"/>
            </intent-filter>
        </activity>
        <meta-data android:name="com.naver.sdk.clientId" android:value="${naverClientId}"/>
        <meta-data android:name="com.naver.sdk.clientSecret" android:value="${naverClientSecret}"/>
        <meta-data android:name="com.naver.sdk.clientName" android:value="북꾸러미"/>
        <meta-data android:name="com.naver.sdk.logEnabled" android:value="false"/>
        <meta-data android:name="com.hagulu.nook.bbbook.kakaoNativeAppKey" android:value="${kakaoNativeAppKey}"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 책 상세 "구매" 버튼이 외부 브라우저로 상품 링크를 여는 데 필요
             (url_launcher, Android 11+ 패키지 가시성). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- 카카오톡 설치 여부 확인(isKakaoTalkInstalled)에 필요한 패키지 가시성. -->
        <package android:name="com.kakao.talk"/>
        <package android:name="com.nhn.android.search"/>
    </queries>
</manifest>
